{
  "manifest_version": 3,
  "name": "Label Batch Capture",
  "version": "1.1.0",
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "unlimitedStorage",
    "debugger"
  ],
  "host_permissions": ["https://huuneh.com/*"]
}
